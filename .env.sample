# Copy to `.env` (or set these in your shell / Compose) and export before `go run ./cmd/server`.
# The binary does not load this file; values must be present in the process environment.

# gRPC
LISTEN_ADDR=localhost:4317
MAX_RECV_MSG_SIZE=16777216

# STORE=memory | clickhouse
STORE=memory

# ClickHouse (used when STORE=clickhouse)
CLICKHOUSE_ADDR=localhost:9000
CLICKHOUSE_DATABASE=default
CLICKHOUSE_USERNAME=default
# Password: use either a literal (local dev) or a file path (see below). File wins if both are set.
# CLICKHOUSE_PASSWORD=
# Path to a file whose contents are the password; overrides CLICKHOUSE_PASSWORD when set
# CLICKHOUSE_PASSWORD_FILE=
